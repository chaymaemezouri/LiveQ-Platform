# Copy to .env in the repository root. Docker Compose, Prisma, and the API all read this file.
# Replace every secret before deploying anywhere other than a local machine.

POSTGRES_USER=liveq
POSTGRES_PASSWORD=liveq
POSTGRES_DB=liveq
POSTGRES_PORT=5433

DATABASE_URL=postgresql://liveq:liveq@localhost:5433/liveq?schema=public

API_PORT=3002
# Public address printed on session QR codes. Use the browser origin, not a Docker hostname.
WEB_ORIGIN=http://localhost:5173
NODE_ENV=development

# Required at API startup. At least 32 characters. Signs speaker access tokens.
JWT_SECRET=dev-only-change-me-please-32chars-min
